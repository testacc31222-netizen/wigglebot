DISCORD_TOKEN=put-your-bot-token-here
# Your Discord user ID (Developer Mode > right-click yourself > Copy User ID).
# Only this user can run .shutdown / .disable / .enable
OWNER_ID=0
# Optional: prefix defaults to .
COMMAND_PREFIX=.
# Optional: for AI chat (Groq free tier). Without a key, bot uses built-in casual brain.
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-oss-20b
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Web dashboard (?key=): set a long random string, NEVER share it
DASHBOARD_KEY=
